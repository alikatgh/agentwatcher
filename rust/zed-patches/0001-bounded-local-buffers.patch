+#[cfg(test)]
+mod local_edit_policy_tests {
+    use super::*;
+    use gpui::{EntityInputHandler, TestAppContext};
+    use language::LocalEditPolicy;
+
+    fn policy(bytes: usize, history_work: usize) -> LocalEditPolicy {
+        LocalEditPolicy {
+            max_serialized_bytes: bytes,
+            max_line_scalars: 4096,
+            newline_bytes: 1,
+            max_history_work: history_work,
+            max_undo_transactions: 2,
+        }
+    }
+
+    #[gpui::test]
+    fn test_local_policy_selection_history_discards_rejected_and_nested_noops(
+        cx: &mut TestAppContext,
+    ) {
+        crate::editor_tests::init_test(cx, |_| {});
+        let buffer = cx.new(|cx| Buffer::local("", cx));
+        buffer.update(cx, |buffer, _| {
+            buffer.set_local_edit_policy(Some(policy(1, 8 * 1024 * 1024)))
+        });
+        let editor = cx.add_window(|window, cx| Editor::for_buffer(buffer, None, window, cx));
+        editor.update(cx, |editor, window, cx| {
+            for _ in 0..1000 {
+                editor.insert("xx", window, cx);
+                editor.transact(window, cx, |_, _, _| {});
+            }
+            assert_eq!(editor.text(cx), "");
+            assert!(
+                editor
+                    .selection_history
+                    .selections_by_transaction
+                    .is_empty()
+            );
+            assert!(editor.local_pending_transaction.is_none());
+            assert!(
+                editor
+                    .start_transaction_at(Instant::now(), window, cx)
+                    .is_some()
+            );
+            assert!(
+                editor
+                    .start_transaction_at(Instant::now(), window, cx)
+                    .is_none()
+            );
+            assert!(editor.end_transaction_at(Instant::now(), cx).is_none());
+            assert!(editor.local_pending_transaction.is_some());
+            assert!(editor.end_transaction_at(Instant::now(), cx).is_none());
+            assert!(editor.local_pending_transaction.is_none());
+            assert!(
+                editor
+                    .selection_history
+                    .selections_by_transaction
+                    .is_empty()
+            );
+        });
+    }
+
+    #[gpui::test]
+    fn test_local_policy_selection_history_preserves_grouped_and_live_undo(
+        cx: &mut TestAppContext,
+    ) {
+        crate::editor_tests::init_test(cx, |_| {});
+        let buffer = cx.new(|cx| Buffer::local("", cx));
+        buffer.update(cx, |buffer, _| {
+            buffer.set_local_edit_policy(Some(policy(16, 8 * 1024 * 1024)));
+            buffer.set_group_interval(Duration::from_secs(60));
+        });
+        let editor = cx.add_window(|window, cx| Editor::for_buffer(buffer, None, window, cx));
+        editor.update(cx, |editor, window, cx| {
+            editor.insert("a", window, cx);
+            let original_id = *editor
+                .selection_history
+                .selections_by_transaction
+                .keys()
+                .next()
+                .unwrap();
+            editor.insert("b", window, cx);
+            assert_eq!(editor.selection_history.selections_by_transaction.len(), 1);
+            assert!(editor.selection_history.transaction(original_id).is_some());
+            assert!(editor.local_pending_transaction.is_none());
+            editor.undo(&Undo, window, cx);
+            assert_eq!(editor.text(cx), "");
+            editor.redo(&Redo, window, cx);
+            assert_eq!(editor.text(cx), "ab");
+            for text in ["c", "d", "e"] {
+                editor.finalize_last_transaction(cx);
+                editor.insert(text, window, cx);
+                assert!(editor.selection_history.selections_by_transaction.len() <= 2);
+            }
+            editor.undo(&Undo, window, cx);
+            editor.undo(&Undo, window, cx);
+            editor.undo(&Undo, window, cx);
+            assert_eq!(editor.text(cx), "abc");
+        });
+    }
+
+    #[gpui::test]
+    fn test_local_policy_native_replacement_rejects_atomically(cx: &mut TestAppContext) {
+        crate::editor_tests::init_test(cx, |_| {});
+        let original = "a".repeat(2048);
+        let buffer = cx.new(|cx| Buffer::local(original.clone(), cx));
+        buffer.update(cx, |buffer, _| {
+            buffer.set_local_edit_policy(Some(policy(2048, 8 * 1024 * 1024)))
+        });
+        let editor = cx.add_window(|window, cx| Editor::for_buffer(buffer, None, window, cx));
+        editor.update(cx, |editor, window, cx| {
+            editor.set_autoindent(false);
+            editor.set_use_autoclose(false);
+            editor.set_use_auto_surround(false);
+            let selections = editor.selections.disjoint_anchors_arc();
+            editor.replace_text_in_range(Some(0..1), "é", window, cx);
+            assert_eq!(editor.text(cx), original);
+            assert_eq!(editor.selections.disjoint_anchors(), &*selections);
+            assert!(
+                editor
+                    .selection_history
+                    .selections_by_transaction
+                    .is_empty()
+            );
+            assert!(editor.local_pending_transaction.is_none());
+            editor.replace_and_mark_text_in_range(Some(0..1), "é", Some(0..1), window, cx);
+            assert_eq!(editor.text(cx), original);
+            assert_eq!(editor.selections.disjoint_anchors(), &*selections);
+            assert!(
+                editor
+                    .text_highlights(HighlightKey::InputComposition, cx)
+                    .is_none()
+            );
+            assert!(editor.ime_transaction.is_none());
+            editor.replace_text_in_range(Some(0..1), "b", window, cx);
+            assert_eq!(editor.text(cx), format!("b{}", "a".repeat(2047)));
+            editor.undo(&Undo, window, cx);
+            assert_eq!(editor.text(cx), original);
+        });
+    }
+
+    #[gpui::test]
+    fn test_local_policy_native_replacement_rejects_exhausted_history_without_deleting(
+        cx: &mut TestAppContext,
+    ) {
+        crate::editor_tests::init_test(cx, |_| {});
+        let buffer = cx.new(|cx| Buffer::local("original", cx));
+        buffer.update(cx, |buffer, _| {
+            buffer.set_local_edit_policy(Some(policy(2048, 0)))
+        });
+        let editor = cx.add_window(|window, cx| Editor::for_buffer(buffer, None, window, cx));
+        editor.update(cx, |editor, window, cx| {
+            let selections = editor.selections.disjoint_anchors_arc();
+            editor.replace_text_in_range(Some(0..8), "new", window, cx);
+            assert_eq!(editor.text(cx), "original");
+            assert_eq!(editor.selections.disjoint_anchors(), &*selections);
+            assert!(
+                editor
+                    .selection_history
+                    .selections_by_transaction
+                    .is_empty()
+            );
+            assert!(editor.local_pending_transaction.is_none());
+        });
+    }
