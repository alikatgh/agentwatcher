+    /// Installs a gate for native quit requests, including macOS Dock Quit and
+    /// logout. Returning false defers the current request while the application
+    /// shows confirmation UI or saves. Call [`App::quit`] after approval; it
+    /// rechecks this callback before completing the original native request.
+    /// Call [`App::cancel_native_quit`] only when the user cancels that request.
+    ///
+    /// Only one callback is retained. This is opt-in and currently supported on
+    /// macOS; it does not change other platforms' quit behavior. A request that
+    /// arrives during an App borrow remains pending instead of bypassing the gate.
+    pub fn on_native_quit_requested(&self, mut callback: impl FnMut(&mut App) -> bool + 'static) {
+        let app = self.this.clone();
+        self.platform.on_quit_requested(Box::new(move || {
+            let Some(app) = app.upgrade() else {
+                return true;
+            };
+            let Ok(mut app) = app.try_borrow_mut() else {
+                return false;
+            };
+            app.update(|cx| callback(cx))
+        }));
+    }
+
+    /// Whether a native quit request is awaiting confirmation or pending work.
+    pub fn native_quit_pending(&self) -> bool {
+        self.platform.native_quit_pending()
+    }
+
+    /// Cancels the pending native quit, including an OS logout or shutdown.
+    /// Call this only after an explicit user decision to keep the app open.
+    pub fn cancel_native_quit(&self) {
+        self.platform.cancel_native_quit();
+    }
