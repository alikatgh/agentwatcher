+type QuitRequestCallback = Rc<RefCell<Box<dyn FnMut() -> bool>>>;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum NativeQuitDecision {
+    Now,
+    Deferred,
+    Check(u64),
+}
+
+impl NativeQuitDecision {
+    fn response(self) -> NSUInteger {
+        // NSApplicationTerminateReply: Now = 1, Later = 2. Only an explicit
+        // cancellation replies NO; deferring must not abort OS logout/shutdown.
+        match self {
+            Self::Now => 1,
+            Self::Deferred | Self::Check(_) => 2,
+        }
+    }
+}
+
+struct PendingNativeQuit {
+    request: u64,
+    check_queued: bool,
+    reply: Option<bool>,
+}
+
+#[derive(Default)]
+struct NativeQuitState {
+    next_request: u64,
+    pending: Option<PendingNativeQuit>,
+}
+
+impl NativeQuitState {
+    fn begin(&mut self, has_callback: bool) -> NativeQuitDecision {
+        if self.pending.is_some() {
+            return NativeQuitDecision::Deferred;
+        }
+        if !has_callback {
+            return NativeQuitDecision::Now;
+        }
+        self.next_request = self.next_request.wrapping_add(1);
+        self.pending = Some(PendingNativeQuit {
+            request: self.next_request,
+            check_queued: false,
+            reply: None,
+        });
+        NativeQuitDecision::Check(self.next_request)
+    }
+
+    fn request_id(&self) -> Option<u64> {
+        self.pending.as_ref().map(|pending| pending.request)
+    }
+
+    fn is_waiting(&self) -> bool {
+        self.pending
+            .as_ref()
+            .is_some_and(|pending| pending.reply.is_none())
+    }
+
+    fn queue_check(&mut self) -> Option<u64> {
+        let pending = self.pending.as_mut()?;
+        if pending.reply.is_some() || pending.check_queued {
+            return None;
+        }
+        pending.check_queued = true;
+        Some(pending.request)
+    }
+
+    fn take_check(&mut self, request: u64) -> bool {
+        let Some(pending) = self.pending.as_mut() else {
+            return false;
+        };
+        if pending.request != request || !pending.check_queued || pending.reply.is_some() {
+            return false;
+        }
+        pending.check_queued = false;
+        true
+    }
+
+    fn queue_reply(&mut self, request: u64, allowed: bool) -> bool {
+        let Some(pending) = self.pending.as_mut() else {
+            return false;
+        };
+        if pending.request != request {
+            return false;
+        }
+        let needs_dispatch = pending.reply.is_none();
+        // Explicit cancellation wins over an approval that is still queued.
+        pending.reply = Some(pending.reply.unwrap_or(true) && allowed);
+        needs_dispatch
+    }
+
+    fn take_reply(&mut self, request: u64) -> Option<bool> {
+        let pending = self.pending.as_ref()?;
+        if pending.request != request {
+            return None;
+        }
+        let reply = pending.reply?;
+        self.pending = None;
+        Some(reply)
+    }
+}
+
+struct NativeQuitDispatch {
+    platform: *const MacPlatform,
+    request: u64,
+}
+
+fn native_quit_approved(callback: Option<&QuitRequestCallback>) -> bool {
+    callback.is_none_or(|callback| {
+        // App or callback reentry remains deferred; it never cancels an OS
+        // request or silently bypasses the application gate.
+        callback
+            .try_borrow_mut()
+            .is_ok_and(|mut callback| callback())
+    })
+}
+
+extern "C" fn should_terminate(this: &mut Object, _: Sel, _: id) -> NSUInteger {
+    let platform = unsafe { get_mac_platform(this) };
+    let (decision, callback) = {
+        let mut state = platform.0.lock();
+        let callback = state.quit_requested.clone();
+        (state.native_quit.begin(callback.is_some()), callback)
+    };
+    // Duplicate/reentrant requests share one pending decision. Do not retain
+    // platform locks across application callbacks or AppKit calls.
+    if let NativeQuitDecision::Check(request) = decision {
+        if native_quit_approved(callback.as_ref()) {
+            platform.reply_to_native_quit(request, true);
+        }
+    }
+    decision.response()
+}
+
+#[cfg(test)]
+mod native_quit_tests {
+    use super::{NativeQuitDecision, NativeQuitState, QuitRequestCallback, native_quit_approved};
+    use std::{
+        cell::{Cell, RefCell},
+        rc::Rc,
+    };
+
+    fn deferred_request(state: &mut NativeQuitState) -> u64 {
+        let decision = state.begin(true);
+        assert_eq!(decision.response(), 2);
+        let NativeQuitDecision::Check(request) = decision else {
+            panic!("expected a new request")
+        };
+        request
+    }
+
+    #[test]
+    fn applications_without_a_quit_gate_keep_native_termination() {
+        let mut state = NativeQuitState::default();
+        assert_eq!(state.begin(false).response(), 1);
+        assert!(!state.is_waiting());
+        assert_eq!(state.queue_check(), None);
+    }
+
+    #[test]
+    fn deferred_request_finishes_with_one_reply_after_success() {
+        let mut state = NativeQuitState::default();
+        let ready = Rc::new(Cell::new(false));
+        let callback_ready = ready.clone();
+        let callback: QuitRequestCallback =
+            Rc::new(RefCell::new(Box::new(move || callback_ready.get())));
+        let request = deferred_request(&mut state);
+        assert!(!native_quit_approved(Some(&callback)));
+        assert!(state.is_waiting());
+        assert_eq!(state.take_reply(request), None);
+        assert_eq!(state.queue_check(), Some(request));
+        assert!(state.take_check(request));
+        assert!(!native_quit_approved(Some(&callback)));
+        assert_eq!(state.take_reply(request), None);
+        // A completed save or process shutdown makes the same request ready.
+        ready.set(true);
+        assert_eq!(state.queue_check(), Some(request));
+        assert!(state.take_check(request));
+        assert!(native_quit_approved(Some(&callback)));
+        assert!(state.queue_reply(request, true));
+        assert!(!state.is_waiting());
+        assert!(!state.queue_reply(request, true));
+        assert_eq!(state.take_reply(request), Some(true));
+        assert_eq!(state.take_reply(request), None);
+        assert_eq!(state.request_id(), None);
+    }
+
+    #[test]
+    fn explicit_cancel_overrides_a_queued_approval() {
+        let mut state = NativeQuitState::default();
+        let request = deferred_request(&mut state);
+        assert!(state.queue_reply(request, true));
+        assert!(!state.queue_reply(request, false));
+        assert!(!state.queue_reply(request, true));
+        assert!(!state.is_waiting());
+        assert_eq!(state.queue_check(), None);
+        assert_eq!(state.take_reply(request), Some(false));
+    }
+
+    #[test]
+    fn explicit_cancel_allows_a_fresh_request_without_accepting_stale_work() {
+        let mut state = NativeQuitState::default();
+        let previous = deferred_request(&mut state);
+        assert_eq!(state.queue_check(), Some(previous));
+        assert!(state.queue_reply(previous, false));
+        assert_eq!(state.take_reply(previous), Some(false));
+        let current = deferred_request(&mut state);
+        assert_ne!(previous, current);
+        assert_eq!(state.queue_check(), Some(current));
+        assert!(!state.take_check(previous));
+        assert!(!state.queue_reply(previous, true));
+        assert_eq!(state.take_reply(previous), None);
+        assert!(state.is_waiting());
+        assert!(state.take_check(current));
+        assert!(state.queue_reply(current, true));
+        assert_eq!(state.take_reply(current), Some(true));
+    }
+
+    #[test]
+    fn duplicate_native_requests_and_poll_checks_are_coalesced() {
+        let mut state = NativeQuitState::default();
+        let request = deferred_request(&mut state);
+        assert_eq!(state.queue_check(), Some(request));
+        for _ in 0..10_000 {
+            assert_eq!(state.begin(true), NativeQuitDecision::Deferred);
+            assert_eq!(state.begin(true).response(), 2);
+            assert_eq!(state.queue_check(), None);
+        }
+        assert!(state.take_check(request));
+        // A not-yet-ready callback leaves the request pending for the next poll.
+        assert!(state.is_waiting());
+        assert_eq!(state.queue_check(), Some(request));
+        assert!(state.take_check(request));
+        assert!(state.queue_reply(request, true));
+        assert_eq!(state.queue_check(), None);
+        assert_eq!(state.take_reply(request), Some(true));
+    }
+
+    #[test]
+    fn reentrant_callback_defers_without_losing_the_outer_request() {
+        let slot = Rc::new(RefCell::new(None));
+        let weak_slot = Rc::downgrade(&slot);
+        let state = Rc::new(RefCell::new(NativeQuitState::default()));
+        let request = deferred_request(&mut state.borrow_mut());
+        let nested_state = state.clone();
+        let callback: QuitRequestCallback = Rc::new(RefCell::new(Box::new(move || {
+            let slot = weak_slot.upgrade().unwrap();
+            assert_eq!(nested_state.borrow_mut().begin(true).response(), 2);
+            assert!(!native_quit_approved(slot.borrow().as_ref()));
+            true
+        })));
+        *slot.borrow_mut() = Some(callback.clone());
+        assert!(native_quit_approved(Some(&callback)));
+        assert_eq!(state.borrow().request_id(), Some(request));
+        assert!(state.borrow_mut().queue_reply(request, true));
+        assert_eq!(state.borrow_mut().take_reply(request), Some(true));
+    }
+}
