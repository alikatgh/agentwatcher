+    fn check_native_quit(&self) {
+        let request = { self.0.lock().native_quit.queue_check() };
+        let Some(request) = request else { return };
+        let context = Box::into_raw(Box::new(NativeQuitDispatch {
+            platform: self,
+            request,
+        }));
+        unsafe {
+            DispatchQueue::main().exec_async_f(context.cast(), check);
+        }
+
+        extern "C" fn check(context: *mut c_void) {
+            // The platform owns AppKit's running application and remains alive
+            // until its main run loop ends. This callback runs on that loop.
+            let context = unsafe { Box::from_raw(context.cast::<NativeQuitDispatch>()) };
+            let platform = unsafe { &*context.platform };
+            let callback = {
+                let mut state = platform.0.lock();
+                if !state.native_quit.take_check(context.request) {
+                    return;
+                }
+                state.quit_requested.clone()
+            };
+            if native_quit_approved(callback.as_ref()) {
+                platform.reply_to_native_quit(context.request, true);
+            }
+        }
+    }
+
+    fn reply_to_native_quit(&self, request: u64, allowed: bool) {
+        if !self.0.lock().native_quit.queue_reply(request, allowed) {
+            return;
+        }
+        let context = Box::into_raw(Box::new(NativeQuitDispatch {
+            platform: self,
+            request,
+        }));
+        unsafe {
+            DispatchQueue::main().exec_async_f(context.cast(), reply);
+        }
+
+        extern "C" fn reply(context: *mut c_void) {
+            let context = unsafe { Box::from_raw(context.cast::<NativeQuitDispatch>()) };
+            let platform = unsafe { &*context.platform };
+            let allowed = { platform.0.lock().native_quit.take_reply(context.request) };
+            if let Some(allowed) = allowed {
+                // Never hold a platform lock or App borrow across AppKit's
+                // synchronous termination callbacks.
+                unsafe {
+                    let app = NSApplication::sharedApplication(nil);
+                    let _: () = msg_send![app,
+                        replyToApplicationShouldTerminate: if allowed { YES } else { NO }
+                    ];
+                }
+            }
+        }
+    }
